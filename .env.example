# Kantin Cashless SKOOLIA - Frontend Environment Configuration

# Backend Kantin API URL
VITE_API_URL=http://localhost:8080

# SKOOLIA Admin Backend API URL (untuk otentikasi login staf)
VITE_ADMIN_BE_URL=http://localhost:8081

# Mock API Layer (set true untuk mengaktifkan mock response lokal tanpa harus menjalankan backend)
VITE_USE_MOCK=true

# Nama Aplikasi
VITE_APP_NAME="Kantin Cashless SKOOLIA"